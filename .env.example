# ╔══════════════════════════════════════════════════════════════════════╗
# ║  FluX environment variables. Copy this file to `.env` and fill it in.  ║
# ║  The API loads this file automatically (api/src/env.ts) regardless of  ║
# ║  the current working directory. The frontend needs its own copy in     ║
# ║  frontend/.env.local (see frontend/.env.example).                      ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── REQUIRED ───────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local dev:  postgresql://postgres:postgres@localhost:5432/flux
# Get from your DB host (Supabase / Neon / RDS / Docker) — it is the standard
# Postgres URI shown by your provider's "connection string" / "pooler" page.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flux"

# Secret used to sign JWT auth tokens. GENERATE your own — never reuse this.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Leave EMPTY until generated: production REFUSES TO START while this is empty,
# a known placeholder, or shorter than 32 characters.
JWT_SECRET=""

# Origin of the frontend, for CORS. Must match the URL users actually open.
CORS_ORIGIN="http://localhost:3000"

# Public URL of the API, baked into the frontend. Put this in frontend/.env.local
# too (Next.js only exposes variables prefixed with NEXT_PUBLIC_ to the browser).
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── RUNTIME MODE ───────────────────────────────────────────────────────────

# "production"  = fail-loud: unconfigured service nodes FAIL the run with a
#                clear message instead of returning a mock result. No fake data,
#                auth is required, dev-user fallback is OFF. This is what you
#                deploy with — and what this example ships as.
# "development" = unconfigured nodes return a clearly-flagged mock (mock:true)
#                so templates run out of the box; the UI badges them "MOCK".
#                Switch to this ONLY for local mock-mode development.
NODE_ENV="production"

# "distributed" = nodes execute in the worker via Kafka (recommended; survives
#                 restarts, scales horizontally). Requires KAFKA_BROKERS.
# anything else = nodes execute in-process inside the API (simplest single-server
#                 setup; fine for one instance).
EXECUTION_MODE="distributed"

PORT=4000

# ── KAFKA (only needed when EXECUTION_MODE=distributed) ────────────────────

# Comma-separated broker list, from your Kafka provider (Confluent / Upstash /
# Aiven / self-hosted). Local dev uses the docker-compose service.
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="flux"
KAFKA_GROUP_ID="flux-worker-group"

# ── AI NODE ─────────────────────────────────────────────────────────────────

# OpenRouter key. Every AI provider (OpenAI, Anthropic, Gemini) is reached
# through OpenRouter, so you only need ONE key.
# Get it at:  https://openrouter.ai/keys  (sign up → "Create Key" → sk-or-v1-…)
# This is the shared/platform fallback. Individual users can instead paste their
# OWN key into the "API Key (Optional)" field of each AI node in the builder,
# which takes priority over this variable.
AI_API_KEY=""
# Alias — the code accepts either name:
# OPENROUTER_API_KEY=""

# ── EMAIL NODE (SMTP) ───────────────────────────────────────────────────────

# The email node needs a working SMTP server. In production an unconfigured SMTP
# FAILS the node loudly (it never pretends to send). Pick ONE provider:
#
#  Resend (simplest, generous free tier):
#     https://resend.com  →  Dashboard → API Keys → "Create API Key"
#     SMTP_HOST="smtp.resend.com"  SMTP_PORT="465"
#     SMTP_USER="resend"           SMTP_PASS="re_xxxxxxxxxxxxxxxx"
#
#  SendGrid:
#     https://app.sendgrid.com → Settings → API Keys → "Create API Key"
#     SMTP_HOST="smtp.sendgrid.net"  SMTP_PORT="587"
#     SMTP_USER="apikey"             SMTP_PASS="SG.xxxxxxxx"
#
#  Mailgun:
#     https://app.mailgun.com  →  Sending → SMTP credentials
#     SMTP_HOST="smtp.mailgun.org"   SMTP_PORT="587"
#     SMTP_USER="postmaster@…"       SMTP_PASS="<smtp password>"
#
#  Amazon SES:
#     AWS Console → SES → SMTP settings → "Create My SMTP Credentials"
#     SMTP_HOST="email-smtp.<region>.amazonaws.com"  SMTP_PORT="587"
#     SMTP_USER="<generated iam smtp username>"      SMTP_PASS="<generated password>"
#
#  Gmail (testing only — Google requires an App Password, not your password):
#     Google Account → Security → 2-Step Verification → "App passwords"
#     SMTP_HOST="smtp.gmail.com"  SMTP_PORT="587"
#     SMTP_USER="you@gmail.com"   SMTP_PASS="<16-char app password>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# "From" address. Defaults to SMTP_USER if omitted.
SMTP_FROM=""
# The SAME SMTP settings also deliver password-reset emails ("Forgot password?").
# In production an unconfigured SMTP makes that endpoint return 503 (fail loud);
# in development the reset link is logged to the API console instead.
#
# Public URL of the frontend, used to build password-reset links in emails.
APP_URL="http://localhost:3000"

# ── SLACK NODE ──────────────────────────────────────────────────────────────

# Slack does NOT use an env variable. Each Slack node has its own "Webhook URL"
# field in the workflow builder. Create one per channel:
#   1. https://api.slack.com/apps  →  "Create New App"  →  "From scratch"
#   2. Name it, pick your workspace  →  "Create App"
#   3. Left menu: "Incoming Webhooks"  →  toggle ON
#   4. "Add New Webhook to Workspace"  →  choose the channel  →  "Allow"
#   5. Copy the URL (https://hooks.slack.com/services/T…/B…/…)
#   6. Paste it into the Slack node's "Webhook URL" field,
#      and set the node's "Channel" to the SAME channel you chose.
# A revoked/expired webhook no longer silently reports success — the node fails
# with the real HTTP status Slack returned.

# ── OAUTH SIGN-IN (frontend, optional) ─────────────────────────────────────

# Enable Google sign-in on the login page. Both are required together.
# Get them at:  https://console.cloud.google.com  →  APIs & Services →
#   Credentials → "Create credentials" → "OAuth client ID" → Web application.
# Add the frontend URL to "Authorized JavaScript origins" and the redirect URI
# (https://<frontend>/api/auth/callback/google) to "Authorized redirect URIs".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# NextAuth (frontend) session secret — REQUIRED in production, generate like
# JWT_SECRET above. Goes in frontend/.env.local (the frontend reads it), shown
# here so both env files are documented in one place.
AUTH_SECRET=""

# ── SECURITY / ADVANCED (optional — safe defaults shown) ──────────────────

# HTTP/webhook/database nodes refuse to call private/internal network ranges
# (SSRF protection). Set to "true" ONLY if you intentionally target internal
# hosts on a trusted network.
# ALLOW_PRIVATE_HTTP_TARGETS="false"

# In development, requests without a token fall back to a dev user so the UI is
# usable without logging in. This is ALWAYS off in production unless explicitly
# set to "true". Never enable it in production.
# ALLOW_DEV_USER_FALLBACK=""

# How often the processor polls the transactional outbox and the scheduler scans
# for due waiting executions (milliseconds).
# OUTBOX_POLL_INTERVAL_MS=1000
# SCHEDULER_POLL_INTERVAL_MS=15000

# Reverse proxy hop count for Express trust proxy. REQUIRED behind nginx/ALB/
# Cloudflare so IP-based rate limits see the real client IP instead of the
# proxy's (one shared bucket for everyone). Leave unset when API is direct.
# TRUST_PROXY=1
