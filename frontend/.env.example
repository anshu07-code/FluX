# ╔══════════════════════════════════════════════════════════════════════╗
# ║  FluX frontend environment. Copy to frontend/.env.local and fill in.  ║
# ║  Only NEXT_PUBLIC_* and server-side (Auth.js) variables belong here —  ║
# ║  the API's own settings live in the root .env (see .env.example).     ║
# ╚══════════════════════════════════════════════════════════════════════╝

# Public URL of the FluX API. Baked into the browser bundle at build time
# (NEXT_PUBLIC_ prefix) — used for all API calls, webhook URLs in the UI,
# and the Auth.js credentials login bridge. Must match the URL users can reach.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Auth.js (NextAuth v5) session-signing secret — REQUIRED in production.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Optional Google sign-in. Both are required together; leave empty to show
# only email/password login. Setup:
#   https://console.cloud.google.com → APIs & Services → Credentials →
#   OAuth client ID (Web application)
#   Authorized JavaScript origin:      http://localhost:3000
#   Authorized redirect URI:           http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
